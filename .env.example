# Copie para .env (o setup.ps1 faz isso e gera a chave automaticamente).

# Chave secreta do Django. Se ficar vazia, uma chave local é gerada em data/secret_key.txt.
CAHIER_SECRET_KEY=

# Endereço e porta. 127.0.0.1 = só este computador (recomendado).
# Para abrir na rede local seria preciso mudar CAHIER_HOST para 0.0.0.0, incluir o IP em
# CAHIER_ALLOWED_HOSTS e desativar o login automático abaixo. Não faça isso sem necessidade.
CAHIER_HOST=127.0.0.1
CAHIER_PORT=8000
CAHIER_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]

# Login automático sem senha no painel administrativo (apenas para acessos do próprio computador).
CAHIER_LOCAL_SINGLE_USER=true

# Fuso horário usado para contar dias de estudo.
CAHIER_TIME_ZONE=America/Sao_Paulo

# Pasta dos dados (banco e backups). Padrão: data/ dentro do projeto.
# CAHIER_DATA_DIR=

# Limites de upload, em MB.
CAHIER_MAX_IMPORT_MB=5
CAHIER_MAX_RESTORE_MB=200

# Modo de depuração (mostra erros detalhados). Deixe false no uso normal.
CAHIER_DEBUG=false

# Endereço do app para celular (versão offline publicada no GitHub Pages).
CAHIER_MOBILE_URL=https://galakcv.github.io/CahierMobile/
